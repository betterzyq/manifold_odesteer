# 复制为 .env 后按需修改。UV_ENV_FILE 指向 .env 时由 uv run 自动加载。

# Google API（毒性评估 Perspective；需本机网络能访问 Google，大陆环境通常要配代理）
GOOGLE_API_KEY=your_google_api_key_here
# HTTPS_PROXY=http://127.0.0.1:7890
# GOOGLE_API_HTTP_TIMEOUT=120

# Hugging Face 国内镜像（中国大陆用户建议保留，模型/数据集下载走 hf-mirror）
HF_ENDPOINT=https://hf-mirror.com

# 缓存到数据盘，避免占满系统盘（按实际数据盘路径修改，如 /root/autodl-tmp、/data）
# HF_HOME=/root/autodl-tmp/.cache/huggingface
